"version": {
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build DrivingRobot",
            "command": "ninja",
            "type": "shell",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/build/Core"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "clean DrivingRobot",
            "type": "shell",
            "command": "ninja",
            "args": ["-v", "clean"],
            "options": {
                "cwd": "${workspaceFolder}/build/Core"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}